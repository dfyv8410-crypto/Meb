# =============================================================
# MEB — Apache .htaccess for shared hosting (Sweb)
# Routes clean URLs through index.php without exposing .php.
# Uses only mod_rewrite (standard on shared hosting).
# =============================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---- Security: never serve sensitive files ----
    RewriteRule ^(config)/ - [F,L]
    RewriteRule ^(includes)/ - [F,L]
    RewriteRule ^(sql)/ - [F,L]
    RewriteRule ^\.git(/|$) - [F,L]
    RewriteRule ^storage/ - [F,L]
    RewriteRule \.(env|ini|log|sql)$ - [F,L]

    # ---- Backup snapshots must never be downloadable (contain client PII) ----
    RewriteRule ^uploads/backups(/|$) - [F,L]

    # ---- Disable execution of PHP in uploads (defense in depth) ----
    RewriteRule ^uploads/.*\.php$ - [F,L]

    # ---- Static files: serve directly if they exist ----
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ---- Everything else -> index.php ----
    RewriteRule ^ index.php [L]
</IfModule>

# ---- PHP execution disabled inside uploads (redundant safety) ----
<FilesMatch "\.(php|phtml|phar)$">
    <IfModule mod_rewrite.c>
        RewriteEngine On
        RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
        RewriteRule ^ - [F]
    </IfModule>
</FilesMatch>

# ---- Security headers (when mod_headers available) ----
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Sitemap hint for crawlers ----
# Note: Sitemap is generated dynamically at /sitemap.xml

# ---- Protect config files directly ----
<FilesMatch "^(config|database)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
